# Copy to .env and fill in. See docs/setup.md. Never commit .env.

# LLMs (one is enough to start; two providers for planner + critic)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Telegram: token from @BotFather. The chat id is only for the CLI scripts; visitors' own chats are their inbox.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEMO_CHAT_ID=

# Optional: public base URL for the Telegram webhook (Render sets RENDER_EXTERNAL_URL itself),
# and a fixed key for visitors' saved browser sessions (derived from the token if empty)
# PUBLIC_URL=
# SESSION_SECRET=

# Database: leave empty for local SQLite; Neon pooled URL for the hosted demo
DATABASE_URL=

# Optional: model chains (provider:model, first working one wins) and a daily token cap
# PLANNER_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash
# CRITIC_MODELS=gemini:gemini-3.5-flash-lite,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_DAILY_TOKENS=300000
