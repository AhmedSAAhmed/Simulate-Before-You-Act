# Copy to .env and fill in. See docs/setup.md. Never commit .env.

# LLMs (one is enough to start; two providers for planner + critic)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Telegram: token from @BotFather; chat id printed by scripts/check_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEMO_CHAT_ID=

# Stripe: test-mode secret key only (sk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=

# Database: leave empty for local SQLite; Neon pooled URL for the hosted demo
DATABASE_URL=
